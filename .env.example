# ==============================================================================
# AI RESUME BUILDER SAAS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to .env (for local dev) or .env.production (for production)
# 2. Never commit active .env files containing real secrets to version control
# ==============================================================================

# Node Environment Mode ('production', 'development', 'test')
NODE_ENV=production

# Backend Service Listening Port
PORT=5000

# Docker Compose Host Frontend Port (e.g. 80, 8080, 3000)
APP_PORT=80

# MongoDB Database Connection String
# Local Docker: mongodb://mongodb:27017/ai_resume_builder
# Atlas Cloud: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_resume_builder?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongodb:27017/ai_resume_builder

# JWT Authentication Secret (Generate with: openssl rand -base64 32)
JWT_SECRET=replace_with_a_secure_long_random_secret_at_least_32_characters

# JWT Expiration Duration (e.g. '7d', '24h', '30d')
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (e.g. 'https://myresumebuilder.com' or '*' for public API)
CORS_ORIGIN=*

# Platform AI Provider Keys (Optional: Users can also supply their own via BYOK in settings)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google OAuth 2.0 Credentials (From Google Cloud Console: https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend Custom API Base (Leave empty if serving via same origin / Docker Nginx reverse proxy)
# VITE_API_BASE_URL=https://api.myresumebuilder.com/api/v1
